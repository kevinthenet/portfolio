---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/Base.astro';
import Recommendation from '../components/Recommendation.astro';
import ProjectScanRow from '../components/ProjectScanRow.astro';

const recommendations = await getCollection('recommendations');
const RECOMMENDATION_ORDER = ['warren-wessels', 'amy-rich', 'izzy-young'];
recommendations.sort(
  (a, b) => RECOMMENDATION_ORDER.indexOf(a.id) - RECOMMENDATION_ORDER.indexOf(b.id)
);

const projects = await getCollection('projects');
const SELECTED_WORK_ORDER = ['rowland-ai', 'pvcase', 'redox'];
const selectedWork = SELECTED_WORK_ORDER.map((id) =>
  projects.find((project) => project.id === id)
).filter((project) => project !== undefined);
---

<BaseLayout
  title="Senior Software Engineer"
  description="Kevin Castro is a senior software engineer who builds and hardens AI-powered systems in high-stakes, regulated domains."
>
  <main>
    <section class="hero bracket-frame">
      <span class="corner tl"></span><span class="corner tr"></span>
      <span class="corner bl"></span><span class="corner br"></span>
      <p class="boot"><span class="ok">[ OK ]</span> identity verified — kevin castro</p>
      <p class="boot">
        <span class="ok">[ OK ]</span> 7yrs exp: healthcare <span class="tag">/</span>
        energy <span class="tag">/</span> conversational AI
      </p>
      <p class="boot">
        <span class="ok">[ OK ]</span> clearance: PHI / HIPAA-grade systems verified
      </p>
      <p class="boot">
        <span class="ok">[ OK ]</span> all systems nominal
      </p>

      <h1 class="headline">
        <span class="glitch-ambient" data-text="Kevin Castro">Kevin Castro</span>
      </h1>
      <p class="role">Senior Software Engineer</p>
      <p class="tagline">
        I build and harden AI-powered systems in high-stakes, regulated
        domains, from pipeline to production.
      </p>
      <div class="cta-row">
        <a class="button" href="mailto:hello@kevincastro.dev">send_email()</a>
        <a
          class="button secondary"
          href="https://www.linkedin.com/in/ortsacnivek/"
          rel="noreferrer">ping linkedin --message</a
        >
      </div>
    </section>

    <section class="work">
      <div class="section-head">
        <h2 class="section-title">// selected_work</h2>
        <span class="section-note">hover to scan</span>
      </div>
      <div class="scan-list">
        {
          selectedWork.map((project) => (
            <ProjectScanRow
              href={`/work/${project.id}`}
              tag={project.data.tag}
              name={project.data.name}
              blurb={project.data.blurb}
              metric={project.data.subtitle}
            />
          ))
        }
      </div>
      <a class="all-work-link" href="/work">$ ls -a /work →</a>
    </section>

    <section class="witness">
      <div class="section-head">
        <h2 class="section-title">// transmissions_received</h2>
      </div>
      <div class="recommendations">
        {recommendations.map((rec) => <Recommendation recommendation={rec} />)}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: var(--reader-width);
    width: 100%;
  }
  .hero {
    padding: 1.75em 1.75em 2.25em;
    margin-bottom: 3em;
  }
  .boot {
    font-size: 0.8em;
    color: var(--text-dim);
    margin: 0 0 0.35em;
    opacity: 0;
    animation: boot-line-in 0.4s ease forwards;
  }
  .boot:nth-of-type(1) {
    animation-delay: 0.1s;
  }
  .boot:nth-of-type(2) {
    animation-delay: 0.35s;
  }
  .boot:nth-of-type(3) {
    animation-delay: 0.6s;
  }
  .boot:nth-of-type(4) {
    animation-delay: 0.85s;
  }
  @keyframes boot-line-in {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .boot {
      opacity: 1;
    }
  }
  .boot .ok {
    color: var(--green);
  }
  .boot .tag {
    opacity: 0.6;
  }
  .headline {
    position: relative;
    margin: 1.25em 0 0.4em;
  }
  .role {
    font-size: 1em;
    letter-spacing: 0.04em;
    color: var(--green);
    margin: 0 0 1.5em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .tagline {
    font-family: -apple-system, 'Segoe UI', system-ui, sans-serif;
    font-size: 1.08em;
    max-width: 52ch;
    margin: 0 0 2.1em;
  }
  .cta-row {
    display: flex;
    gap: 0.85em;
    flex-wrap: wrap;
  }

  .work {
    padding: 0 0 4em;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1em;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.85em;
    margin-bottom: 1.5em;
    flex-wrap: wrap;
  }
  .section-title {
    font-weight: 800;
    font-size: 1em;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin: 0;
  }
  .section-note {
    font-size: 0.7em;
    color: var(--text-dim);
    letter-spacing: 0.03em;
  }
  .scan-list {
    display: flex;
    flex-direction: column;
    gap: 1em;
  }
  .all-work-link {
    display: inline-block;
    margin-top: 1.5em;
    font-size: 0.85em;
    color: var(--green);
  }
  .all-work-link:hover {
    color: var(--magenta);
  }

  .witness {
    padding: 0 0 3em;
  }
  .recommendations {
    display: grid;
    row-gap: 1.25em;
  }

  @media (max-width: 700px) {
    .hero {
      padding: 1.5em 1.25em 2em;
    }
  }
</style>

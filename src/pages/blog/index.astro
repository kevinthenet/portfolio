---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/Base.astro';

import Card from '../../components/Card.astro';

const blogEntries = await getCollection('blog');
---

<BaseLayout
  title="Blog"
  description="Writing from Kevin Castro on secure AI systems, software craftsmanship, and engineering practice."
>
  <main>
    <h1>// blog</h1>
    {
      blogEntries.length === 0 ? (
        <div class="empty-state">
          <p><span class="prompt">$ ls ./posts</span></p>
          <p><span class="info">[ INFO ]</span> &nbsp; no entries found!</p>
          <p>
            <span class="info">[ INFO ]</span> &nbsp; new posts are in the works,
            check back soon
          </p>
        </div>
      ) : (
        <div class="blog-grid">
          {blogEntries.map((blogEntry) => (
            <Card
              isClickable={true}
              title={blogEntry.data.title}
              href={`/blog/${blogEntry.id}`}
              body={blogEntry.data.summary}
            />
          ))}
        </div>
      )
    }
  </main>
</BaseLayout>

<style>
  main {
    width: var(--reader-width);
  }
  h1 {
    font-size: 1.6em;
    margin-bottom: 0.75em;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(1, 100% [col-start]);
    row-gap: 1em;
  }
  .empty-state {
    font-family: -apple-system, 'Segoe UI', system-ui, sans-serif;
    color: var(--text-dim);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 1.25em 1.5em;
  }
  .empty-state p {
    margin: 0 0 0.35em;
  }
  .empty-state p:last-child {
    margin-bottom: 0;
  }
  .prompt {
    font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
    color: var(--green);
  }
  .empty-state .info {
    color: var(--cyan);
  }
</style>

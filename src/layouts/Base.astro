---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  image?: string | undefined;
}

const DEFAULT_DESCRIPTION =
  'Senior software engineer who builds secure, AI-powered, & data-intensive systems in high-stakes, regulated domains.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = '/og-image.png',
} = Astro.props;

const siteURL = Astro.site?.toString().replace(/\/$/, '') ?? '';
const personId = `${siteURL}/#person`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: 'Kevin Castro',
    jobTitle: 'Senior Software Engineer',
    description: DEFAULT_DESCRIPTION,
    url: siteURL,
    sameAs: [
      'https://www.linkedin.com/in/ortsacnivek/',
      'https://github.com/kevinthenet',
    ],
    knowsAbout: [
      'Agentic LLM Pipelines',
      'RAG Infrastructure',
      'HIPAA-Compliant Systems',
      'System Design',
      'Healthcare Data Exchange',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Kevin Castro',
    url: siteURL,
    author: { '@id': personId },
  },
];
---

<!doctype html>
<html
  lang="en"
  color-mode="dark"
>
  <Head
    title={title}
    description={description}
    image={image}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <body>
    <Header />
    <slot />
    <Footer />
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-0Z7MFLZV7E"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', 'G-0Z7MFLZV7E');
    </script>
  </body>
</html>

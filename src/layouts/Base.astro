---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const DEFAULT_DESCRIPTION =
  'Senior software engineer who builds secure AI-powered systems in high-stakes, regulated domains.';

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
---

<!doctype html>
<html
  lang="en"
  color-mode="dark"
>
  <Head
    title={title}
    description={description}
  />
  <body>
    <Header />
    <slot />
    <Footer />
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-0Z7MFLZV7E"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', 'G-0Z7MFLZV7E');
    </script>
  </body>
</html>

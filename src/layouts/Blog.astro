---
import type { CollectionEntry } from 'astro:content';

import BaseLayout from './Base.astro';

import FormattedDate from '../components/FormattedDate.astro';

import '../styles/blog-post.css'; // the only way I was able to use custom styling for markdown generated HTML

type Props = CollectionEntry<'blog'>;
const { data: post } = Astro.props;
---

<BaseLayout title={post.title} description={post.summary}>
  <section class="hero">
    <h1>{post.title}</h1>
    <h3>{post.summary}</h3>
    <FormattedDate timestamp={post.publishDate} />
  </section>
  <main>
    <article class="text-content">
      <slot />
    </article>
    <a class="back-link" href="/blog">$ cd ..<span>&nbsp;back to blog</span></a>
  </main>
</BaseLayout>

<style>
  article {
    width: var(--reader-width);
    max-width: 100%;
    padding: 1.5em;
  }
  .hero {
    text-align: center;
    padding: 1.5em;
  }
  .hero h3 {
    font-family: -apple-system, 'Segoe UI', system-ui, sans-serif;
    font-weight: normal;
    color: var(--text-dim);
  }
  .back-link {
    display: inline-block;
    margin-top: 1em;
    color: var(--green);
  }
  .back-link:hover {
    color: var(--magenta);
  }
</style>

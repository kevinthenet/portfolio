---
import type { CollectionEntry } from 'astro:content';

import BaseLayout from './Base.astro';

import FormattedDate from '../components/FormattedDate.astro';

import '../styles/blog-post.css'; // the only way I was able to use custom styling for markdown generated HTML

type Props = CollectionEntry<'blog'>;
const { data: post } = Astro.props;
---

<BaseLayout title={post.title} description={post.summary}>
  <section class="hero">
    <h1>{post.title}</h1>
    <h3>{post.summary}</h3>
    <FormattedDate timestamp={post.publishDate} />
  </section>
  <main>
    <article class="text-content">
      <slot />
    </article>
    <a href="/blog"><span>&larr;</span>Back to Blog</a>
  </main>
</BaseLayout>

<style>
  article {
    width: var(--reader-width);
  }
  .hero {
    text-align: center;
  }
</style>

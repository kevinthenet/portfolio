---
// Dark is the default theme; only an explicit stored preference for light overrides it.
const labelText = `Toggle Light Mode`;
const stateIcons = {
  light: '\u{263C}', // white sun with rays
  dark: '\u{2600}', // black sun with rays
};
---

<a class="color-mode-toggle" aria-label={labelText}>
  {`${stateIcons['light']} ${labelText}`}
</a>

<script>
  const stateIcons = {
    light: '\u{263C}',
    dark: '\u{2600}',
  };
  const colorModeToggleButton = document.querySelector('a.color-mode-toggle');
  const capitalize = (str: string) => str[0]!.toUpperCase() + str.slice(1);
  const updateButton = (colorMode: keyof typeof stateIcons) => {
    const prevStateText = `Toggle ${capitalize(colorMode)} Mode`;
    colorModeToggleButton!.setAttribute('aria-label', prevStateText);
    colorModeToggleButton!.textContent = `${stateIcons[colorMode]} ${prevStateText}`;
  };

  // Dark is the default; an explicit stored preference is the only thing that overrides it.
  const initialMode = localStorage.getItem('color-mode') === 'light' ? 'light' : 'dark';
  document.documentElement.setAttribute('color-mode', initialMode);
  updateButton(initialMode === 'dark' ? 'light' : 'dark');

  const toggleColorMode = () => {
    const currentState = document.documentElement.getAttribute('color-mode');
    let nextState: keyof typeof stateIcons;

    switch (currentState) {
      case 'light':
        nextState = 'dark';
        break;
      case 'dark':
        nextState = 'light';
        break;
      default:
        // dark is the site default
        nextState = 'dark';
    }

    // change style
    document.documentElement.setAttribute('color-mode', nextState);
    // change button text and icon
    updateButton(currentState! as keyof typeof stateIcons);
    // store this for later
    localStorage.setItem('color-mode', nextState);
  };

  colorModeToggleButton!.addEventListener('click', toggleColorMode);
</script>

<style>
  a {
    display: inline-flex;
    align-items: center;
    padding: 0.4em 0.6em;
    font-size: 0.75em;
    font-weight: bold;
    border: 1px solid var(--border);
    cursor: pointer;
    color: var(--text-dim);
    white-space: nowrap;
  }
  a:hover {
    color: var(--text);
    border-color: var(--green);
  }
</style>

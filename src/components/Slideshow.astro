---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: { image: ImageMetadata; alt: string }[];
}
const { photos } = Astro.props;
---

<div class="slideshow">
  <div
    class="slideshow-container"
    tabindex="0"
    role="group"
    aria-roledescription="carousel"
    aria-label="Project screenshots"
  >
    {
      photos.map(({ image, alt }) => (
        <Image
          src={image}
          alt={alt}
          class="slide"
          loading="lazy"
          widths={[480, 800, 1200]}
          sizes="(max-width: 800px) 100vw, 45vw"
        />
      ))
    }
  </div>
  <!-- Empty hrefs with prevent default allow tabbing for users navigating that way -->
  <a class="prev" href="" aria-label="Previous image">&larr;</a>
  <a class="next" href="" aria-label="Next image">&rarr;</a>
  <div class="breadcrumbs">
    {photos.map((_, index) => <span class="breadcrumb" id={`slide-${index}`}>&#x25A1;</span>)}
  </div>
</div>

<style>
  .slideshow-container {
    width: 100%;
    height: 30em;
    background: var(--bg-card);
    border: 1px solid var(--border);
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .slideshow-container::-webkit-scrollbar {
    display: none;
  }
  .slideshow-container:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: -2px;
  }
  .slideshow {
    position: relative;
    width: 100%;
  }
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  .breadcrumbs {
    text-align: center;
    padding-top: 0.5em;
    font-size: 1.2em;
    color: var(--text-dim);
  }
  .breadcrumb {
    cursor: pointer;
  }
  .prev,
  .next {
    color: var(--text);
    position: absolute;
    top: 25%;
    cursor: pointer;
    transition: background-color 0.2s ease-in-out, color 0.2s ease-in-out;
    padding: 12.5% 5%;
  }
  .next {
    right: 0;
  }

  .prev:is(:hover, :focus-within),
  .next:is(:hover, :focus-within) {
    color: var(--green);
    background-color: rgba(0, 0, 0, 0.35);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: scale-down;
    object-position: center;
  }
  @media (max-width: 640px) {
    .slideshow-container {
      height: 16em;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLDivElement>('.slideshow').forEach((slideshow) => {
    const container = slideshow.querySelector<HTMLDivElement>('.slideshow-container')!;
    const slides = Array.from(slideshow.querySelectorAll<HTMLImageElement>('.slide'));
    const breadcrumbs = Array.from(slideshow.querySelectorAll<HTMLSpanElement>('.breadcrumb'));

    const breadcrumbStates = {
      selected: '&#x25A3;',
      unselected: '&#x25A1;',
    };

    let currentSlide = 0;

    function setActiveBreadcrumb(index: number) {
      breadcrumbs[currentSlide]!.innerHTML = breadcrumbStates['unselected'];
      breadcrumbs[index]!.innerHTML = breadcrumbStates['selected'];
      currentSlide = index;
    }

    function goToSlide(index: number) {
      if (index >= slides.length) index = 0;
      if (index < 0) index = slides.length - 1;
      slides[index]!.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
    }

    // Swipe/scroll updates the active breadcrumb without re-triggering scrollIntoView.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActiveBreadcrumb(slides.indexOf(entry.target as HTMLImageElement));
          }
        }
      },
      { root: container, threshold: 0.6 },
    );
    slides.forEach((slide) => observer.observe(slide));

    slideshow.querySelector('.prev')?.addEventListener('click', (e) => {
      e.preventDefault();
      goToSlide(currentSlide - 1);
    });
    slideshow.querySelector('.next')?.addEventListener('click', (e) => {
      e.preventDefault();
      goToSlide(currentSlide + 1);
    });
    breadcrumbs.forEach((breadcrumb, index) => {
      breadcrumb.addEventListener('click', () => goToSlide(index));
    });

    setActiveBreadcrumb(0);
  });
</script>

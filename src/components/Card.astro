---
type Clickable = {
  isClickable: true;
  title: string;
  body: string;
  href: string;
};

type NonClickable = {
  isClickable: false;
  title: string;
  subtitle: string;
  annotation: string;
  image: {
    url: string;
    alt: string;
  };
};

export type Props = Clickable | NonClickable;

// @ts-ignore ts(2339) - ignoring due to type guards being used in the component
// but the props are expecting a static interface
const { isClickable, title, subtitle, annotation, body, href, image } = Astro.props;
---

<li class=`link-card ${isClickable ? 'clickable' : 'nonclickable'}`>
  {
    isClickable ? (
      <a href={href} class="card bracket-frame">
        <span class="corner tl" />
        <span class="corner tr" />
        <span class="corner bl" />
        <span class="corner br" />
        <h2>
          {title}
          <span>&rarr;</span>
        </h2>
        <p>{body}</p>
      </a>
    ) : (
      <div class="card decrypt-panel bracket-frame">
        <span class="corner tl" />
        <span class="corner tr" />
        <span class="corner bl" />
        <span class="corner br" />
        <p class="decrypt-head">[ DECRYPTED ]</p>
        <div class="header">
          <div class="badge">
            <img src={image.url} alt={image.alt} loading="lazy" />
          </div>
          <div class="details">
            <h2>{title}</h2>
            <h4>{subtitle}</h4>
            <p class="relation">{annotation}</p>
          </div>
        </div>
        <div class="content">
          <slot />
        </div>
      </div>
    )
  }
</li>

<style>
  .link-card {
    display: flex;
    list-style: none;
  }
  .card {
    width: 100%;
    background: var(--bg-card);
    color: var(--text);
  }
  .link-card > a.card {
    text-decoration: none;
    line-height: 1.4;
    padding: 1em 1.3em;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  h2 {
    margin: 0;
    font-size: 1.15em;
    text-transform: uppercase;
    font-weight: 700;
  }
  h2 span {
    color: var(--green);
  }
  p {
    margin-top: 0.5em;
    margin-bottom: 0;
    font-family: -apple-system, 'Segoe UI', system-ui, sans-serif;
    color: var(--text-dim);
  }
  .clickable:is(:hover, :focus-within) a.card {
    transform: translateY(-3px);
  }
  .clickable:is(:hover, :focus-within) h2 {
    color: var(--magenta);
  }
  .decrypt-panel {
    padding: 1.75em 2em;
    display: flex;
    flex-direction: column;
    gap: 1em;
  }
  .decrypt-head {
    font-size: 0.72em;
    color: var(--magenta);
    letter-spacing: 0.04em;
    margin: 0;
  }
  .header {
    display: grid;
    grid-template-columns: [first] auto [second] 1fr [end];
    gap: 1em;
    align-items: center;
  }
  .content {
    font-family: -apple-system, 'Segoe UI', system-ui, sans-serif;
    font-size: 1.02em;
  }
  img {
    width: 3.5em;
    height: 3.5em;
    border-radius: 50%;
    border: 2px solid var(--cyan);
    object-fit: cover;
  }
  .details > h2 {
    font-size: 1em;
  }
  .details > h4 {
    margin: 0;
    font-weight: normal;
    color: var(--text-dim);
    font-size: 0.85em;
  }
  .relation {
    margin: 0.4em 0 0;
    font-family: -apple-system, 'Segoe UI', system-ui, sans-serif;
    font-size: 0.82em;
    color: var(--text-dim);
    opacity: 0.85;
  }
  @media (max-width: 640px) {
    .decrypt-panel {
      padding: 1.25em 1.4em;
    }
    .header {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
</style>

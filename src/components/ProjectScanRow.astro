---
export interface Props {
  href: string;
  tag: string;
  date?: string | undefined;
  name: string;
  blurb: string;
  metric: string;
}

const { href, tag, date, name, blurb, metric } = Astro.props;
---

<a class="scan-item bracket-frame" href={href}>
  <span class="corner tl"></span><span class="corner tr"></span>
  <span class="corner bl"></span><span class="corner br"></span>
  <span class="scan-tag-group">
    <span class="scan-tag">{tag}</span>
    {date && <span class="scan-date">{date}</span>}
  </span>
  <span class="scan-body">
    <h3>{name}</h3>
    <span class="scan-desc-wrap">
      <span class="scan-desc blurb">{blurb}</span>
      <span class="scan-desc metric">{metric}</span>
    </span>
  </span>
  <span class="scan-arrow" aria-hidden="true">&rarr;</span>
</a>

<style>
  .scan-item {
    display: grid;
    grid-template-columns: 8.5em 1fr 1.5em;
    gap: 1.25em;
    align-items: center;
    padding: 1.1em 1.3em;
    background: var(--bg-card);
    text-decoration: none;
    color: var(--text);
    border: 1px solid transparent;
  }
  .scan-tag-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35em;
  }
  .scan-tag {
    font-size: 0.68em;
    color: var(--text-dim);
    border: 1px solid var(--border);
    padding: 0.3em 0.5em;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .scan-date {
    font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.68em;
    color: var(--text-dim);
    opacity: 0.7;
    letter-spacing: 0.03em;
    padding: 0 0.15em;
  }
  .scan-body {
    min-width: 0;
  }
  .scan-body h3 {
    margin: 0 0 0.3em;
    font-size: 1em;
    font-weight: 700;
    text-transform: uppercase;
  }
  .scan-desc-wrap {
    position: relative;
    display: block;
    min-height: 2.8em;
  }
  .scan-desc {
    position: absolute;
    inset: 0;
    font-family: -apple-system, 'Segoe UI', system-ui, sans-serif;
    font-size: 0.88em;
    line-height: 1.4;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .scan-desc.blurb {
    color: var(--text-dim);
    opacity: 1;
    transform: translateY(0);
  }
  .scan-desc.metric {
    color: var(--green);
    opacity: 0;
    transform: translateY(4px);
    text-shadow: 0 0 8px color-mix(in srgb, var(--green) 45%, transparent);
  }
  .scan-item:hover .scan-desc.blurb,
  .scan-item:focus-visible .scan-desc.blurb {
    opacity: 0;
    transform: translateY(-4px);
  }
  .scan-item:hover .scan-desc.metric,
  .scan-item:focus-visible .scan-desc.metric {
    opacity: 1;
    transform: translateY(0);
    animation: text-glitch 0.3s steps(3);
  }
  @keyframes text-glitch {
    0% {
      text-shadow: -2px 0 var(--magenta), 2px 0 var(--cyan);
    }
    40% {
      text-shadow: 2px 0 var(--magenta), -2px 0 var(--cyan);
    }
    100% {
      text-shadow: 0 0 8px color-mix(in srgb, var(--green) 45%, transparent);
    }
  }
  .scan-arrow {
    justify-self: end;
    color: var(--text-dim);
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .scan-item:hover .scan-arrow,
  .scan-item:focus-visible .scan-arrow {
    color: var(--magenta);
    transform: translateX(3px);
  }

  @media (max-width: 760px) {
    .scan-item {
      grid-template-columns: 1fr;
      gap: 0.6em;
    }
    .scan-arrow {
      display: none;
    }
  }
</style>

---
import SocialButtons from './SocialButtons.astro';
---

<footer class="page-boundary">
  {Astro.url.pathname !== '/' && <SocialButtons />}
  <div class="sign-off">
    <p>
      interested in working together? send a message to <a
        href="mailto:hello@kevincastro.dev">hello@kevincastro.dev</a
      >
    </p>
    <p class="dim">
      built by kevin castro with &lt;3 using <a
        href="https://astro.build/"
        rel="noreferrer"
        >astro</a
      >
    </p>
  </div>
</footer>

<style>
  footer {
    padding: 1.5em;
    display: flex;
    justify-content: space-between;
    flex-direction: column;
    gap: 1em;
  }
  .sign-off {
    justify-content: center;
    display: flex;
    text-align: center;
    flex-direction: column;
    gap: 0.5em;
    font-size: 0.85em;
  }
  .sign-off a {
    color: var(--green);
  }
  .sign-off a:hover {
    color: var(--magenta);
  }
  .dim {
    color: var(--text-dim);
    font-size: 0.85em;
  }
</style>
